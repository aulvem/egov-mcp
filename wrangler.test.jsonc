{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "egov-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": ["EgovMcp"],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "EgovMcp",
				"name": "MCP_OBJECT"
			}
		]
	}
}
